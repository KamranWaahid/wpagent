# Copy to `.env` (`chmod 600`). Never commit.

# --- Cursor / Claude (stdio) and ChatGPT (personal HTTP) ---
WPAGENT_URL=https://your-wordpress.example
WPAGENT_USERNAME=admin
WPAGENT_APP_PASSWORD=

# Required for ChatGPT --http / a public tunnel. Anyone with the tunnel URL still needs this Bearer.
WPAGENT_HTTP_TOKEN=

# --- Hosted multi-tenant only (shelved: WPAGENT_HTTP_MODE=hosted) ---
# WPAGENT_DOMAIN=mcp.example.com
# WPAGENT_PUBLIC_URL=https://mcp.example.com
# WPAGENT_SESSION_SECRET=replace-with-a-long-random-string
# RESEND_API_KEY=
# WPAGENT_EMAIL_FROM=WPAgent <noreply@example.com>
