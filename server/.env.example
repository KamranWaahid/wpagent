# Copy to .env or export in your MCP client config.
# Never commit real Application Passwords or session secrets.

# --- Local stdio (Claude Desktop / Cursor) ---
# WPAGENT_URL=https://example.com
# WPAGENT_USERNAME=admin
# WPAGENT_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WPAGENT_SITES={"blog":{"url":"https://blog.example.com","username":"admin","password":"xxxx"}}
# WPAGENT_SITES_FILE=/Users/you/.wpagent/sites.json

# --- Personal HTTP (ChatGPT tunnel). Default for --http. ---
# WPAGENT_HTTP=1
# WPAGENT_HTTP_MODE=personal
# WPAGENT_HTTP_HOST=127.0.0.1
# WPAGENT_HTTP_PORT=3333
# WPAGENT_HTTP_TOKEN=generate-a-long-random-string

# --- Hosted multi-tenant (shelved) ---
# WPAGENT_HTTP_MODE=hosted
# WPAGENT_PUBLIC_URL=https://mcp.example.com
# WPAGENT_SESSION_SECRET=generate-a-long-random-string
# WPAGENT_SESSION_STORE=file
# WPAGENT_SESSION_DIR=/app/data
# WPAGENT_EMAIL_PROVIDER=resend
# WPAGENT_EMAIL_FROM=WPAgent <noreply@example.com>
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# WPAGENT_HTTP_ALLOW_ANON_ENV=0

# Optional: Unsplash for search_stock_photos
# UNSPLASH_ACCESS_KEY=
