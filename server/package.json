{
  "name": "wpagent-mcp-server",
  "version": "0.12.0",
  "description": "WPAgent MCP server — translates AI tool calls into authenticated WordPress plugin requests.",
  "homepage": "https://github.com/KamranWaahid/wpagent",
  "bugs": {
    "url": "https://github.com/KamranWaahid/wpagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamranWaahid/wpagent.git"
  },
  "author": "Kamran Wahid",
  "type": "module",
  "bin": {
    "wpagent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
